{
  "title": "Lancy's Mappings",
  "rules": [
    {
      "description": "<CapsLock> behaves like <Ctrl> when hold and <Esc> when pressed.",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "caps_lock",
            "modifiers": {
              "optional": ["any"]
            }
          },
          "to": [
            {
              "key_code": "left_control"
            }
          ],
          "to_if_alone": [
            {
              "key_code": "escape"
            }
          ]
        }
      ]
    },
    {
      "description": "<Ctrl> + <;> behaves like <Ctrl> + <a>",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "semicolon",
            "modifiers": {
              "mandatory": ["left_control"]
            }
          },
          "to": [
            {
              "key_code": "a",
              "modifiers": ["left_control"]
            }
          ]
        }
      ]
    }
  ]
}
