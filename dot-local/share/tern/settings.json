{
  "theme": "System",
  "theme_dark": "dark-tokyo-night",
  "theme_light": "light-tokyo-night",
  "three_finger_swipes": false,
  "cursor": {
    "smooth_blink": true
  },
  "font_size": 15,
  "ui_font_size": 15,
  "font_family": "Maple Mono Normal NL NFM CN",
  "padding_x": 36,
  "padding_y": 36,
  "ui_font": "SF Pro",
  "code_font": "Maple Mono Normal NL NFM CN",
  "surface_tab_width": 4,
  "composer_text": "Markdown",
  "agent_placement": "new_tab",
  "keybinds": {
    "cmd+q": "quit",
    "ctrl+shift+c": "copy",
    "ctrl+shift+v": "paste",
    "cmd+c": "copy",
    "cmd+v": "paste",
    "ctrl+a>ctrl+a": "text:\\x01",
    "ctrl+a>ctrl+e": "open_config",
    "ctrl+a>ctrl+r": "reload_config",
    "ctrl+a>ctrl+x": "close_tab",
    "ctrl+a>1": "goto_tab:1",
    "ctrl+a>2": "goto_tab:2",
    "ctrl+a>3": "goto_tab:3",
    "ctrl+a>4": "goto_tab:4",
    "ctrl+a>5": "goto_tab:5",
    "ctrl+a>6": "goto_tab:6",
    "ctrl+a>7": "goto_tab:7",
    "ctrl+a>8": "goto_tab:8",
    "ctrl+a>9": "goto_tab:9",
    "ctrl+a>n": "move_tab_right",
    "ctrl+a>b": "move_tab_left",
    "ctrl+a>ctrl+c": "new_tab",
    "ctrl+a>ctrl+n": "next_tab",
    "ctrl+a>ctrl+b": "previous_tab",
    "ctrl+a>t": "rename_tab",
    "ctrl+a>h": "move_pane:left",
    "ctrl+a>j": "move_pane:down",
    "ctrl+a>k": "move_pane:up",
    "ctrl+a>l": "move_pane:right",
    "ctrl+a>ctrl+h": "focus_pane:left",
    "ctrl+a>ctrl+j": "focus_pane:down",
    "ctrl+a>ctrl+k": "focus_pane:up",
    "ctrl+a>ctrl+l": "focus_pane:right",
    "ctrl+a>minus": "decrease_font_size",
    "ctrl+a>equal": "increase_font_size",
    "ctrl+a>ctrl+v": "split_right"
  }
}